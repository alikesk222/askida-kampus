<IfModule mod_rewrite.c>
    RewriteEngine On

    # HSTS yalnızca istemci HTTPS ile geliyorsa (alt alan adlarını kapsamaz)
    RewriteCond %{HTTPS} =on [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} =https
    RewriteRule ^ - [E=ASKIDA_HTTPS:1]

    # ── BOT & TARAYICI ENGELLEMESI ──────────────────────────────

    # 1. Boş User-Agent (tarayıcı robotları)
    RewriteCond %{HTTP_USER_AGENT} ^-?$
    RewriteRule ^ - [R=403,L]

    # 2. Bilinen saldırı araçları
    RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|nmap|masscan|zgrab|dirbuster|gobuster|wfuzz|acunetix|netsparker|w3af|skipfish|havij|ZmEu|Morfeus|WPScan|OpenVAS|Burpsuite|NetSparker|jndi|${jndi|python-httpx) [NC]
    RewriteRule ^ - [R=403,L]

    # 3. WordPress / CMS zafiyet taramaları
    RewriteCond %{REQUEST_URI} ^/?(\.|wp-admin|wp-login|xmlrpc|phpmyadmin|pma|myadmin|adminer|setup\.php|install\.php|config\.php|shell|c99|r57|b374k|webshell|eval-stdin|vendor/phpunit|composer\.phar|\.git|\.svn|\.htpasswd|\.DS_Store|backup|db_backup|dump\.sql) [NC]
    RewriteRule ^ - [R=403,L]

    # 4. Log4Shell / JNDI enjeksiyon denemeleri
    RewriteCond %{QUERY_STRING} (\$\{jndi:|%24%7Bjndi%) [NC]
    RewriteRule ^ - [R=403,L]

    # ── NORMAL YÖNLENDİRME ──────────────────────────────────────
    # Yerel: /askida/public/ | Production: /

    RewriteBase /askida/public/

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Güvenlik başlıkları
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.tailwindcss.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://cdn.tailwindcss.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
    Header always set Strict-Transport-Security "max-age=15552000" env=ASKIDA_HTTPS
    Header always set Strict-Transport-Security "max-age=15552000" env=REDIRECT_ASKIDA_HTTPS
</IfModule>

# PHP ayarları
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
</IfModule>
